# PostgreSQL database connection URI (Docker or cloud provider)
DATABASE_URL="postgresql://postgres:password123@localhost:5432/minibank?schema=public"

# Backend API URL for Frontend deployment:
# - Leave blank ("") when frontend and backend are deployed together (same-origin / Next.js).
# - Set to your deployed backend URL when frontend is hosted separately on Vercel/Netlify.
# Example: NEXT_PUBLIC_API_URL=https://minibank-api.onrender.com
NEXT_PUBLIC_API_URL=""

# Allowed Origin for CORS (Optional, defaults to reflecting request origin or *)
# Example: ALLOWED_ORIGIN=https://my-frontend.vercel.app
ALLOWED_ORIGIN=""
